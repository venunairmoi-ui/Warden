<?xml version="1.0" encoding="utf-8"?>
<!--
    Sprint 2: FileProvider path config. Only the app's own private
    "attachments" subfolder (filesDir/attachments/) is exposed: that's
    where AttachmentStorage.kt copies every captured/picked photo and PDF,
    and where CameraX captures directly to. Nothing else in app storage is
    shared.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="attachments" path="attachments/" />
</paths>

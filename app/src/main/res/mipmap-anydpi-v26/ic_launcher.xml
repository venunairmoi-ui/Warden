<?xml version="1.0" encoding="utf-8"?>
<!-- Wisma adaptive icon (UI redesign pass, 2026-08-25). Foreground is now a
     raster asset (@mipmap/ic_launcher_foreground, one PNG per density
     bucket) rather than the placeholder vector shield — the real logo mark,
     isolated to just the glyph (no wordmark; text doesn't survive the mask)
     and extracted from the user-provided artwork via luminance-as-alpha
     keying, sized to sit inside the adaptive-icon safe zone (~58% of the
     108dp canvas, comfortably within the 66dp-diameter circle every launcher
     mask guarantees stays visible). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>

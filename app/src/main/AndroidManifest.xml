<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sprint 2: camera capture -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Sprint 5: local reminder notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
         Sprint 6/9: opt-in auto-detect of new receipts/warranty-card screenshots.
         Declared here because the manifest requires it, but per spec section 7
         this is requested at RUNTIME ONLY when the user explicitly enables
         Auto-detect in Settings — never at first launch, and Play Store's
         restricted-permission disclosure requirement (see spec section 7 /
         README) must be satisfied before this ships.

         READ_MEDIA_IMAGES (API 33+) is the modern, scoped replacement for
         gallery access; READ_EXTERNAL_STORAGE (maxSdkVersion 32) covers
         API 26-32 devices, where READ_MEDIA_IMAGES doesn't exist as a
         platform permission at all and requesting it is a no-op. See
         autodetect/MediaPermission.kt for the matching runtime branch —
         without this second declaration, Auto-detect would silently never
         work on any pre-Android-13 device, a meaningful share of the
         Indian install base this app targets.

         READ_MEDIA_VISUAL_USER_SELECTED (API 34+) covers the "Select
         photos" partial-access grant: on Android 14+, requesting
         READ_MEDIA_IMAGES can surface Allow all / Select photos / Don't
         allow, and choosing "Select photos" denies READ_MEDIA_IMAGES
         itself while silently granting this one instead, scoped to the
         chosen photos. Declaring it here is what lets that grant actually
         reach the app instead of being dropped by the OS. See
         MediaPermission.hasMediaImageAccess, which is the check every
         access point (worker, Settings toggle, permission callback) uses
         instead of testing READ_MEDIA_IMAGES alone.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".WardenApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Warden"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Warden.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
        Sprint 5: notification action buttons ("Mark serviced", "Snooze")
        deliver here via PendingIntent.getBroadcast — never triggered by
        anything outside this app, so exported="false".
        -->
        <receiver
            android:name=".reminders.ReminderActionReceiver"
            android:exported="false" />

        <!--
        Sprint 2: needed for CameraX to hand a captured photo's content:// URI
        to other apps / for the capture flow to read it back. Only
        filesDir/attachments/ is exposed (see res/xml/file_paths.xml).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
        Sprint 3: Share-intent capture (images AND PDFs — this is the "share
        from WhatsApp/Gmail/Files" flow from spec section 4).
        -->
        <activity
            android:name=".capture.ShareReceiverActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

    </application>
</manifest>
